{
  "title": "Chart Values",
  "type": "object",
  "properties": {
    "provider": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "description": "Host-published provider address and gRPC port.",
          "default": "",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "cluster-autoscaler": {
      "type": "object",
      "properties": {
        "fullnameOverride": {
          "type": "string",
          "description": "Name used for Cluster Autoscaler resources.",
          "default": "minikube-cluster-autoscaler-addon"
        },
        "cloudProvider": {
          "type": "string",
          "description": "Cluster Autoscaler provider; this addon uses externalgrpc.",
          "default": "externalgrpc",
          "const": "externalgrpc"
        },
        "autoDiscovery": {
          "type": "object",
          "properties": {
            "clusterName": {
              "type": "string",
              "description": "Minikube profile name.",
              "default": "minikube"
            }
          },
          "additionalProperties": true
        },
        "image": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "description": "Cluster Autoscaler image tag, matched to the Kubernetes minor version.",
              "default": "v1.35.0",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
            }
          },
          "additionalProperties": true
        },
        "replicaCount": {
          "type": "integer",
          "description": "Number of Cluster Autoscaler replicas.",
          "default": 1
        },
        "extraArgs": {
          "type": "object",
          "properties": {
            "cloud-config": {
              "type": "string",
              "description": "Path to the mounted external gRPC provider configuration.",
              "default": "/etc/provider/cloud-config.yaml"
            },
            "max-node-provision-time": {
              "type": "string",
              "description": "Maximum time allowed for a new worker to become ready.",
              "default": "16m",
              "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "scale-down-delay-after-add": {
              "type": "string",
              "description": "Delay before considering scale down after adding a node.",
              "default": "5m",
              "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "scale-down-unneeded-time": {
              "type": "string",
              "description": "Time a node must remain unneeded before removal.",
              "default": "5m",
              "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "scale-down-unready-time": {
              "type": "string",
              "description": "Time an unready node must remain unneeded before removal.",
              "default": "10m",
              "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "max-scale-down-parallelism": {
              "type": "integer",
              "description": "Maximum concurrent node removals.",
              "default": 1
            },
            "max-nodes-per-scaleup": {
              "type": "integer",
              "description": "Maximum nodes added in one scale-out decision.",
              "default": 1
            },
            "enable-provisioning-requests": {
              "type": "boolean",
              "description": "Enable ProvisioningRequest processing.",
              "default": true
            },
            "skip-nodes-with-local-storage": {
              "type": "boolean",
              "description": "Keep nodes with pods using local storage.",
              "default": true
            },
            "skip-nodes-with-system-pods": {
              "type": "boolean",
              "description": "Keep nodes with non-DaemonSet system pods.",
              "default": true
            },
            "leader-elect": {
              "type": "boolean",
              "description": "Enable leader election among autoscaler replicas.",
              "default": true
            },
            "v": {
              "type": "integer",
              "description": "Cluster Autoscaler log verbosity.",
              "default": 4
            }
          },
          "additionalProperties": true
        },
        "extraVolumes": {
          "type": "array",
          "description": "Provider configuration volume name.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Client TLS volume name."
              },
              "configMap": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Provider configuration ConfigMap name."
                  },
                  "defaultMode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  "optional": {
                    "type": "boolean"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "path"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "mode": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 511
                        }
                      }
                    }
                  }
                },
                "additionalProperties": false
              },
              "secret": {
                "type": "object",
                "properties": {
                  "secretName": {
                    "type": "string",
                    "description": "Client TLS Secret name."
                  },
                  "defaultMode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  "optional": {
                    "type": "boolean"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "path"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "mode": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 511
                        }
                      }
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "description": "Mounted volume name.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Mounted volume name."
              },
              "mountPath": {
                "type": "string",
                "description": "Container mount path."
              },
              "readOnly": {
                "type": "boolean",
                "description": "Mount the volume read-only."
              }
            },
            "additionalProperties": true
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU reserved for Cluster Autoscaler.",
                  "default": "100m"
                },
                "memory": {
                  "type": "string",
                  "description": "Memory reserved for Cluster Autoscaler.",
                  "default": "128Mi"
                }
              },
              "additionalProperties": true
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU limit for Cluster Autoscaler.",
                  "default": "500m"
                },
                "memory": {
                  "type": "string",
                  "description": "Memory limit for Cluster Autoscaler.",
                  "default": "512Mi"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "nodeSelector": {
          "type": "object",
          "properties": {
            "minikube-autoscaler.astrivant.com/pool": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Generated by make chart-docs from values.yaml and values.schema.constraints.json."
}
