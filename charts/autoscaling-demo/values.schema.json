{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workload",
    "hpa",
    "loadGenerator"
  ],
  "properties": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "workMilliseconds",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "workMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "scaleDownStabilizationSeconds"
      ],
      "properties": {
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "loadGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "profile",
        "activeDeadlineSeconds",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "pattern": "^files/profiles/[a-zA-Z0-9][a-zA-Z0-9_/-]*\\.json$"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
