{
  "title": "Chart Values",
  "type": "object",
  "properties": {
    "workload": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "description": "Traffic receiver image.",
          "default": "python:3.13-alpine",
          "minLength": 1
        },
        "workMilliseconds": {
          "type": "integer",
          "description": "CPU work performed per request, in milliseconds.",
          "default": 100,
          "minimum": 1,
          "maximum": 1000
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU request for the receiver.",
                  "default": "200m",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "description": "Memory request for the receiver.",
                  "default": "64Mi",
                  "minLength": 1
                }
              },
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU limit for the receiver.",
                  "default": "500m",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "description": "Memory limit for the receiver.",
                  "default": "128Mi",
                  "minLength": 1
                }
              },
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "image",
        "workMilliseconds",
        "resources"
      ]
    },
    "hpa": {
      "type": "object",
      "properties": {
        "minReplicas": {
          "type": "integer",
          "description": "Minimum receiver replicas.",
          "default": 1,
          "minimum": 1,
          "maximum": 17
        },
        "maxReplicas": {
          "type": "integer",
          "description": "Maximum receiver replicas; each replica requires a separate node.",
          "default": 3,
          "minimum": 1,
          "maximum": 17
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "description": "CPU utilization target relative to each receiver CPU request.",
          "default": 50,
          "minimum": 1,
          "maximum": 100
        },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "description": "HPA scale-down stabilization window in seconds.",
          "default": 60,
          "minimum": 0,
          "maximum": 3600
        }
      },
      "additionalProperties": false,
      "required": [
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "scaleDownStabilizationSeconds"
      ]
    },
    "loadGenerator": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Run the load generator Job.",
          "default": true
        },
        "image": {
          "type": "string",
          "description": "k6 load generator image.",
          "default": "grafana/k6:1.3.0",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "description": "Load profile JSON file packaged under files/profiles/.",
          "default": "files/profiles/default.json",
          "pattern": "^files/profiles/[a-zA-Z0-9][a-zA-Z0-9_/-]*\\.json$"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "description": "Maximum load generator Job duration in seconds.",
          "default": 3600,
          "minimum": 60,
          "maximum": 86400
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU request for the load generator.",
                  "default": "100m",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "description": "Memory request for the load generator.",
                  "default": "64Mi",
                  "minLength": 1
                }
              },
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU limit for the load generator.",
                  "default": "500m",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "description": "Memory limit for the load generator.",
                  "default": "256Mi",
                  "minLength": 1
                }
              },
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "profile",
        "activeDeadlineSeconds",
        "resources"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "workload",
    "hpa",
    "loadGenerator"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Generated by make chart-docs from values.yaml and values.schema.constraints.json."
}
